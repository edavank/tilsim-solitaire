# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase config (hassas)
google-services.json
GoogleService-Info.plist
google-service-account.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
play-store-key.json
credentials.json
build*.apk
build.log
*.bak

# Asset backups - never commit
assets/.bak-*
assets/*-old-*
assets/*.bak
assets/*.rgb-orig*
